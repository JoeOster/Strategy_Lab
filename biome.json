{
	"$schema": "https://biomejs.dev/schemas/1.7.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"files": {
		"ignore": [
			"node_modules",
			"node_modules/**",
			"dist",
			"build",
			"log",
			".gemini",
			"playwright-report",
			"test-results"
		]
	}
}
